{
  "name": "@project/blog",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "db-validate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prisma validate --schema=apps/blog/prisma/schema.prisma"
          ],
          "parallel": false
        }
      },
      "db-generate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prisma generate --schema=apps/blog/prisma/schema.prisma"
          ],
          "parallel": false
        }
      },
      "db-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prisma migrate dev --schema=apps/blog/prisma/schema.prisma"
          ],
          "parallel": false
        }
      },
      "db-reset": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "prisma migrate reset --schema=apps/blog/prisma/schema.prisma"
          ],
          "parallel": false
        }
      },
      "db-fill": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx ts-node apps/blog/prisma/seed.ts"
          ],
          "parallel": false
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/blog/dist/package.json",
          "{workspaceRoot}/apps/blog/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/blog/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@project/blog:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@project/blog:build:development"
          },
          "production": {
            "buildTarget": "@project/blog:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
